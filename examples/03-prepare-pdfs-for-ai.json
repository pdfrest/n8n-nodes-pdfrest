      "notes": "Replace this Agent with a vector store insert node when using the workflow as a RAG ingestion pipeline.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "gpt-5-mini"
