    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "billing@example.com",
        "toEmail": "={{ $('Shape Invoice Data').item.json.customerEmail }}",
        "subject": "={{ 'Invoice ' + $('Shape Invoice Data').item.json.invoiceNumber }}",
        "emailFormat": "text",
        "text": "Your signed invoice is attached.",
        "options": {
          "fileAttachments": "data",
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
