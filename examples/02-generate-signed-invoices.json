      "id": "59dc39a1-229b-43d4-a9dd-fa1bc27321e0",
      "name": "Append Standard Terms",
      "notes": "Enable this optional Merge PDFs step to append the PDF supplied in the terms file field.",
      "notesInFlow": true,
      "credentials": {
        "pdfRestApi": {
          "id": "YOUR_PDFREST_CREDENTIAL_ID",
          "name": "pdfRest account"
        }
      },
      "disabled": true
