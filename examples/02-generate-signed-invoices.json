      ],
      "id": "8895db89-ee0a-447f-8d08-80c07f2b11c9",
      "name": "Provide Terms Input"
    },
    {
      "parameters": {
        "operation": "merge",
        "mergeInputs": {
          "input": [
            {
              "inputType": "inputFile",
              "inputFileDataFieldName": "data",
              "pages": "all"
            },
            {
              "inputType": "inputFile",
              "inputFileDataFieldName": "terms",
              "pages": "all"
            }
          ]
        },
        "downloadOutputFiles": true,
        "outputFileDataFieldName": "data",
        "options": {},
        "requestOptions": {}
      },
      "type": "CUSTOM.pdfRest",
      "typeVersion": 1,
