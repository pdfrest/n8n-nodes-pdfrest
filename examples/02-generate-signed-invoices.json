      "parameters": {
        "operation": "addImage",
        "inputType": "inputFile",
        "inputFileDataFieldName": "data",
        "imageInputType": "inputFile",
        "imageFileDataFieldNames": [
          "logo"
        ],
        "imageObjects": "[{\"image_index\":0,\"page\":1,\"x\":450,\"y\":700,\"width\":100}]",
        "downloadOutputFiles": true,
        "outputFileDataFieldName": "data",
        "options": {},
        "requestOptions": {}
      },
      "type": "CUSTOM.pdfRest",
      "typeVersion": 1,
      "position": [
        480,
        80
      ],
      "id": "5d307d70-281e-40f3-a684-de4294defe87",
      "name": "Add Logo",
      "credentials": {
        "pdfRestApi": {
          "id": "YOUR_PDFREST_CREDENTIAL_ID",
          "name": "pdfRest account"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1152,
        224
      ],
      "id": "5bd8489a-1bbc-455e-bf18-094c5a164a82",
      "name": "Provide Signing Files"
    },
    {
      "parameters": {
        "operation": "sign",
        "inputType": "inputFile",
        "inputFileDataFieldName": "data",
        "credentialType": "pfx",
        "pfxCredentialInputType": "inputFile",
        "pfxCredentialFileDataFieldName": "pfx",
        "pfxPassphraseInputType": "inputFile",
        "pfxPassphraseFileDataFieldName": "pfxPassphrase",
        "signatureConfiguration": "{\"type\":\"new\",\"name\":\"invoice-signature\",\"location\":{\"page\":\"1\",\"bottom_left\":{\"x\":\"54\",\"y\":\"36\"},\"top_right\":{\"x\":\"270\",\"y\":\"108\"}},\"display\":{\"include_datetime\":\"true\",\"name\":\"Your Company\",\"reason\":\"Invoice approval\"}}",
        "downloadOutputFiles": true,
        "outputFileDataFieldName": "data",
        "options": {},
        "requestOptions": {}
      },
      "type": "CUSTOM.pdfRest",
      "typeVersion": 1,
      "position": [
        1376,
        224
      ],
      "id": "a22e521f-c1e7-4e07-a892-cc88abbf4bf1",
      "name": "Digitally Sign Invoice",
      "notes": "Supply your own certificate. The workflow will fail at this step until you provide a valid PFX and passphrase file.",
      "notesInFlow": true,
      "credentials": {
        "pdfRestApi": {
          "id": "YOUR_PDFREST_CREDENTIAL_ID",
          "name": "pdfRest account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
